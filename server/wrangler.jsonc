{
  // 서불리 시티 게임 서버 — GitHub Actions가 main에 push될 때마다 자동 배포 (CLOUDFLARE_API_TOKEN 시크릿 필요)
  "name": "seobuly-city",
  "main": "worker.js",
  "compatibility_date": "2025-04-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "GAME_ROOMS", "class_name": "GameRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }]
}
